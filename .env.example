# Copy to .env and fill in from the Supabase dashboard (docs/setup.md, step 7). Both values are public.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Turnstile site key (docs/setup.md, step 15). Public. Leave it unset locally: no captcha shows.
# VITE_TURNSTILE_SITE_KEY=0x...

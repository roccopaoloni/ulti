{
  // The rules package is pure TypeScript shared by the Vite client and Deno Edge Functions.
  // - No DOM or Node globals ("lib" without DOM, "types" empty), so I/O can't creep in.
  // - "nodenext" makes relative imports spell out their ".ts" extension, which Deno and
  //   the Supabase CLI's bundler require.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023"],
    "types": [],
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
